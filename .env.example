# HabitFlow Frontend Environment Variables
# Obtain these from your Supabase Dashboard: Settings -> API

# The public URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# The client-side publishable key (anon key)
# DO NOT put your secret service_role key here!
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here
